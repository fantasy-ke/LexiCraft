{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SerilogLogging": {
    "ApplicationName": "Fantasy.Files",
    "EnableAsync": true,
    "EnableConsole": true,
    "EnableFileLogging": true,
    "Seq": {
      "Enabled": false,
      "ServerUrl": "http://localhost:5341",
      "ApiKey": ""
    },
    "MinimumLevelOverrides": {
      "Microsoft": "Information",
      "System": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Data Source=fliesdb"
  },
  "OpenApiOptions": {
    "Title": "词汇技艺 Files Api",
    "Description": "词汇技艺文件管理相关接口",
    "AuthorName": "Fantasy"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "AgileConfig": {
    "Nodes": "http://172.31.21.1:8500",
    "AppId": "lexicraft-files-grpc",
    "Secret": "bb123456",
    "ENV": "dev"
  },
  "FilesStorageCompatibility": {
    "LegacyBucket": ""
  },
  "OSSOptions": {
    "Enable": false,
    "DefaultProvider": "files",
    "Providers": {
      "files": {
        "Type": "Minio",
        "Endpoint": "localhost:9000",
        "AccessKey": "minio",
        "SecretKey": "minio123",
        "DefaultBucket": "fantasy-files",
        "Region": "us-east-1",
        "IsEnableHttps": false,
        "IsEnableCache": true
      }
    }
  },
  "OAuthOptions": {
    "Authority": "http://localhost:5002",
    "Audience": "files-api",
    "ValidAudiences": [
      "files-api",
      "identity-api"
    ],
    "ValidIssuers": [
      "identity-api"
    ],
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true
  },
  "PermissionAuthorizationOptions": {
    "AdministratorRole": "admin",
    "IdentityApiBaseAddress": "http://localhost:5002",
    "IdentityApiValidationPath": "/api/v1/identity/permissions/validate"
  }
}
